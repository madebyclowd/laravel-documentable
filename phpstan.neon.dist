includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8

    paths:
        - src

    excludePaths:
        - src/../vendor

    checkModelProperties: false

    # The baseline only shrinks: an entry that no longer matches fails the run, so a fixed error has to be
    # removed from phpstan-baseline.neon in the same change.
    reportUnmatchedIgnoredErrors: true
