{
    "name": "madebyclowd/laravel-documentable",
    "description": "Customizable, S3-compatible-first document storage for Laravel — dedup, versioning, multipart uploads, orphan cleanup.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "s3",
        "document",
        "documentable",
        "storage",
        "multipart",
        "versioning",
        "r2",
        "minio"
    ],
    "authors": [
        {
            "name": "I Gede Widiantara",
            "email": "widiantara@clowdlab.com",
            "homepage": "https://github.com/wawanwidiantara"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "MadeByClowd\\Documentable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MadeByClowd\\Documentable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MadeByClowd\\Documentable\\DocumentableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
